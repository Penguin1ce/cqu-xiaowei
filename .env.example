# 复制为 .env 后填写。.env 已加入 gitignore，不要提交。
# 未填写的项使用 core/config.py 中的默认值（与 docker/docker-compose.yml 保持一致）。

APP_ENV=dev
APP_LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cqu
MYSQL_PASSWORD=cqu
MYSQL_DATABASE=cqu_affairs

REDIS_URL=redis://127.0.0.1:6379/0

MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=campus_kb

# DeepSeek 对话模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 通义（阿里云百炼）Embedding / Rerank
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
