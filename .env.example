# 复制为 .env 后填写。.env 已加入 gitignore，不要提交。
# 未填写的项使用 core/config.py 中的默认值（与 docker/docker-compose.yml 保持一致）。

APP_ENV=dev
APP_LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cqu
MYSQL_PASSWORD=cqu
MYSQL_DATABASE=cqu_affairs

REDIS_URL=redis://127.0.0.1:6379/0

MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=campus_kb

# DeepSeek 对话模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动 SiliconFlow：Embedding + Rerank 共用一个密钥
# 仅 Qwen3-Embedding 系列支持 EMBEDDING_DIM：8B 最高 4096，4B 最高 2560，0.6B 最高 1024
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SILICONFLOW_EMBEDDING_DIM=1024
SILICONFLOW_RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# MinerU 文档解析（云端精准解析 API，Token 在 https://mineru.net/apiManage 申请）
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm

# 知识库检索（可选，默认值见 core/config.py RagSettings）
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.3
